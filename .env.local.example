# 管理画面のパスワード（必ず変更してください）
ADMIN_PASSWORD=change-me

# 保存先ドライバー: local | s3
STORAGE_DRIVER=local
# local のとき、原本の保存先（未設定なら <プロジェクト>/data/uploads）
STORAGE_LOCAL_DIR=

# S3 / Cloudflare R2 に切り替えるとき用（STORAGE_DRIVER=s3）
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 1ファイルの上限（MB）
MAX_FILE_MB=200

# 高解像度化（Upscayl）
# Upscayl.app が入っていれば自動で使います。使いたくないときは false。
UPSCALE_ENABLED=true
# 既定: /Applications/Upscayl.app/Contents/Resources/bin/upscayl-bin
UPSCAYL_BIN=
# 既定: /Applications/Upscayl.app/Contents/Resources/models
UPSCAYL_MODELS=
# モデル名。upscayl-standard-4x / digital-art-4x / high-fidelity-4x /
# remacri-4x / ultrasharp-4x / ultramix-balanced-4x / upscayl-lite-4x
UPSCAYL_MODEL=upscayl-standard-4x
# 1件あたりの上限時間（ミリ秒）
UPSCALE_TIMEOUT_MS=900000

# ── 入稿データの色 ─────────────────────────────
# トンボ付きPDFを CMYK に変換するときの ICC。未設定なら Adobe 同梱の Japan Color 2001 Coated を使う
CMYK_ICC_PROFILE=

# ── AI で比率に合わせて描き足す（Black Forest Labs / FLUX Outpainting） ──
# https://dashboard.bfl.ai で発行。未設定なら管理画面の「AIで描き足す」は選べない
# ※ 使うとお客さんの画像が BFL のサーバーへ送信されます
BFL_API_KEY=
# 地域を固定したいとき: https://api.eu.bfl.ai / https://api.us.bfl.ai
BFL_API_BASE=https://api.bfl.ai
